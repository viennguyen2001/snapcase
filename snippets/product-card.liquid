{% doc %}
@param {product} product - Product to display
{% enddoc %}
<article class="product-card"><div class="product-picture"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a>{% if product.compare_at_price > product.price %}<span class="badge">{{ 'products.sale' | t }}</span>{% endif %}<a class="quick-add" href="{{ product.url }}" aria-label="Add {{ product.title | escape }}"><span class="quick-add-icon">{% render 'icon', name: 'cart' %}</span><span class="quick-add-label">Add</span></a></div><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p class="price">{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>{% unless product.has_only_default_variant %}<span class="muted">{{ product.options | join: ' / ' | escape }}</span>{% endunless %}</article>
