<section class="wrap section-space press"><h2>{{ section.settings.title | escape }}</h2><div class="press-grid">{% for block in section.blocks %}<figure {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.author | escape }}</figcaption></figure>{% endfor %}</div></section>
{% schema %}
{"name": "Testimonials", "settings": [{"type": "text", "id": "title", "label": "Heading", "default": "Designed for everyday life"}], "presets": [{"name": "Testimonials"}], "blocks": [{"type": "quote", "name": "Quote", "settings": [{"type": "textarea", "id": "quote", "label": "Quote"}, {"type": "text", "id": "author", "label": "Author"}]}]}
{% endschema %}