<section class="wrap section-space"><h1>{{ 'general.search' | t }}</h1><form action="{{ routes.search_url }}" method="get" class="search-form"><label class="visually-hidden" for="SearchQuery">{{ 'general.search' | t }}</label><input type="search" name="q" id="SearchQuery" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}"><button class="button">{{ 'general.search' | t }}</button></form>{% if search.performed %}{% paginate search.results by 24 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncate: 160 }}</p></article>{% endif %}{% else %}<p>{{ 'general.no_results' | t }}</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}
{"name": "Main Search", "settings": [], "presets": [{"name": "Main Search"}]}
{% endschema %}