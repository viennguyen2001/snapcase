{% assign chosen = product.selected_or_first_available_variant %}

<div class="wrap product-breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span aria-hidden="true">/</span>
  {% if product.collections.first %}
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
    <span aria-hidden="true">/</span>
  {% endif %}
  <span>{{ product.title | escape }}</span>
</div>

<section class="wrap section-space product-page product-page--journey">
  <div class="product-gallery">
    <div class="product-gallery-stage">
      {% for media in product.media %}
        <div class="product-media{% unless forloop.first %} product-media--hidden{% endunless %}" data-media-id="{{ media.id }}">
          {% case media.media_type %}
            {% when 'image' %}
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '700, 1000, 1400, 1800',
                  sizes: '(min-width: 900px) 55vw, 100vw',
                  alt: media.alt | default: product.title
              }}
            {% when 'video' %}
              {{ media | video_tag: controls: true, preload: 'metadata' }}
            {% when 'external_video' %}
              {{ media | external_video_tag }}
            {% when 'model' %}
              {{ media | model_viewer_tag }}
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    {% if product.media.size > 1 %}
      <div class="product-thumbs" role="list">
        {% for media in product.media %}
          {% if media.preview_image %}
            <button type="button" class="product-thumb{% if forloop.first %} is-selected{% endif %}" data-product-media="{{ media.id }}" aria-label="View product image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-info product-info--journey">
    {% if product.vendor != blank %}
      <p class="muted product-vendor">{{ product.vendor | escape }}</p>
    {% endif %}

    <h1>{{ product.title | escape }}</h1>

    <div class="product-rating" aria-label="{{ product.title | escape }} rating">
      <span aria-hidden="true">★★★★★</span>
      <a href="#product-reviews">{{ section.settings.review_text | escape }}</a>
    </div>

    <p class="price product-price" data-product-price>{{ chosen.price | money }}</p>

    <p class="product-finance">4 interest-free installments available at checkout.</p>

    {% if section.settings.shipping_note != blank %}
      <p class="product-shipping-note">{{ section.settings.shipping_note | escape }}</p>
    {% endif %}

    {% form 'product', product, class: 'product-form' %}
      {{ form.errors | default_errors }}
      <select class="visually-hidden" name="id" data-product-variant-select aria-label="Product variant">
        {% for variant in product.variants %}
          <option
            value="{{ variant.id }}"
            data-options="{{ variant.options | join: '||' | escape }}"
            data-price="{{ variant.price | money | escape }}"
            data-available="{{ variant.available }}"
            {% if variant.id == chosen.id %}selected{% endif %}
          >
            {{ variant.title | escape }}
          </option>
        {% endfor %}
      </select>

      {% if product.options_with_values.size > 0 %}
        <div class="product-options">
          {% for option in product.options_with_values %}
            <fieldset class="product-option">
              <legend>{{ option.name }}: <strong data-option-label="{{ option.position }}">{{ chosen.options[forloop.index0] }}</strong></legend>
              <div class="product-option-values">
                {% for value in option.values %}
                  <button
                    type="button"
                    class="option-chip{% if chosen.options[forloop.parentloop.index0] == value %} is-selected{% endif %}"
                    data-option-value="{{ value | escape }}"
                    data-option-position="{{ option.position }}"
                  >
                    {% if option.position == 1 %}
                      {% assign option_variant = product.variants | where: 'option1', value | first %}
                      {% if option_variant.featured_image %}
                        {{ option_variant.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: value }}
                      {% endif %}
                    {% endif %}
                    {{ value | escape }}
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
      {% endif %}

      <label class="product-quantity-label" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
      <div class="quantity-control">
        <button type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
        <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1">
        <button type="button" data-quantity-plus aria-label="Increase quantity">+</button>
      </div>

      <div class="product-stock" data-product-stock>
        <span class="stock-pill stock-pill--in">● In stock</span>
        <span class="stock-pill stock-pill--low">● Low stock</span>
      </div>

      <button
        class="button full product-add-button"
        type="submit"
        name="add"
        data-add-button
        data-add="{{ 'products.add' | t }}"
        data-sold="{{ 'products.sold_out' | t }}"
        {% unless chosen.available %}disabled{% endunless %}
      >
        {% if chosen.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}
      </button>

      <button class="shopify-payment-button" type="submit" name="checkout">Buy it now</button>
    {% endform %}

    <div class="product-promises" role="list">
      <div role="listitem"><strong>{{ section.settings.promise_one_title | escape }}</strong><span>{{ section.settings.promise_one_text | escape }}</span></div>
      <div role="listitem"><strong>{{ section.settings.promise_two_title | escape }}</strong><span>{{ section.settings.promise_two_text | escape }}</span></div>
      <div role="listitem"><strong>{{ section.settings.promise_three_title | escape }}</strong><span>{{ section.settings.promise_three_text | escape }}</span></div>
    </div>
  </div>
</section>

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Main Product",
  "settings": [
    { "type": "text", "id": "review_text", "label": "Review text", "default": "9 reviews" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Free shipping and 30-day returns" },
    { "type": "text", "id": "promise_one_title", "label": "Promise one title", "default": "USA Based" },
    { "type": "text", "id": "promise_one_text", "label": "Promise one text", "default": "Local support" },
    { "type": "text", "id": "promise_two_title", "label": "Promise two title", "default": "Express Shipping" },
    { "type": "text", "id": "promise_two_text", "label": "Promise two text", "default": "Nationwide delivery" },
    { "type": "text", "id": "promise_three_title", "label": "Promise three title", "default": "Free Returns" },
    { "type": "text", "id": "promise_three_text", "label": "Promise three text", "default": "30-day money back guarantee" },
    { "type": "text", "id": "description_eyebrow", "label": "Description eyebrow", "default": "The Journey Promise" },
    { "type": "text", "id": "description_heading", "label": "Description heading", "default": "Designed for everyday journeys" }
  ],
  "presets": [{ "name": "Main Product" }]
}
{% endschema %}
