<section class="wrap section-space product-page"><div class="product-gallery">{% for media in product.media %}{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy' }}{% when 'video' %}{{ media | video_tag: controls: true, preload: 'metadata' }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}{% endfor %}</div><div class="product-info"><p class="muted">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1>{% assign chosen = product.selected_or_first_available_variant %}<p class="price" data-product-price>{{ chosen.price | money }}</p>{% form 'product', product %}{{ form.errors | default_errors }}<label for="Variant-{{ section.id }}">{{ 'products.variant' | t }}</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant.id == chosen.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}</option>{% endfor %}</select><label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1"><button class="button full" type="submit" name="add" data-add-button data-add="{{ 'products.add' | t }}" data-sold="{{ 'products.sold_out' | t }}" {% unless chosen.available %}disabled{% endunless %}>{% if chosen.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>{% endform %}<div class="rte">{{ product.description }}</div></div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name": "Main Product", "settings": [], "presets": [{"name": "Main Product"}]}
{% endschema %}