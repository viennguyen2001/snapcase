<footer class="footer"><div class="wrap footer-grid"><div><h3>{{ section.settings.about_heading | escape }}</h3><div class="rte">{{ section.settings.about }}</div></div><div><h3>{{ section.settings.menu_heading | escape }}</h3>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.all_products' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>{% endfor %}</div><div><h3>{{ 'general.more' | t }}</h3>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div><div><h3>{{ section.settings.newsletter_heading | escape }}</h3><p>{{ section.settings.newsletter_text | escape }}</p>{% form 'customer', id: 'NewsletterForm' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">{{ 'general.email' | t }}</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'general.email' | t }}" required autocomplete="email">{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'general.subscribed' | t }}</p>{% endif %}<button class="button" type="submit">{{ 'general.subscribe' | t }}</button>{% endform %}</div></div><div class="wrap footer-bottom"><span>© {{ 'now' | date: '%Y' }}, {{ shop.name | escape }}.</span><div class="payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div>{% if localization.available_countries.size > 1 %}<div class="wrap region">{% form 'localization' %}<label for="Country">{{ 'general.region' | t }}</label><select id="Country" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select><button type="submit">{{ 'general.update' | t }}</button>{% endform %}</div>{% endif %}</footer>
{% schema %}
{"name": "Footer", "settings": [{"type": "text", "id": "about_heading", "label": "About heading", "default": "About Journey"}, {"type": "richtext", "id": "about", "label": "About text", "default": "<p>Innovative products to elevate productivity and efficiency.</p>"}, {"type": "text", "id": "menu_heading", "label": "Menu heading", "default": "Get in Touch"}, {"type": "link_list", "id": "menu", "label": "Footer menu"}, {"type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Follow us along our Journey"}, {"type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "For the latest news and offers, sign up for our newsletter"}], "presets": [{"name": "Footer"}]}
{% endschema %}