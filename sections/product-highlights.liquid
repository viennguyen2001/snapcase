<section class="wrap section-space product-highlights">
  <div class="product-highlight-grid">
    {% for block in section.blocks %}
      <article class="product-highlight" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          {{ block.settings.icon | image_url: width: 180 | image_tag: loading: 'lazy', class: 'product-highlight-icon', alt: block.settings.title }}
        {% endif %}
        <h3>{{ block.settings.title | escape }}</h3>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product highlights",
  "settings": [],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Locate at all times." },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product highlights",
      "blocks": [
        { "type": "highlight", "settings": { "title": "Locate at all times." } },
        { "type": "highlight", "settings": { "title": "Create content." } },
        { "type": "highlight", "settings": { "title": "Keep hydrated." } },
        { "type": "highlight", "settings": { "title": "Watch content." } }
      ]
    }
  ]
}
{% endschema %}
