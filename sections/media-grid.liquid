<section class="wrap section-space media-grid">
  {% for block in section.blocks %}
    {% if block.settings.image != blank %}
      <a class="media-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.title }}
        <h3>{{ block.settings.title | escape }} <span>↗</span></h3>
      </a>
    {% endif %}
  {% endfor %}
</section>
{% schema %}{"name": "Media Grid", "settings": [], "presets": [{"name": "Media Grid"}], "blocks": [{"type": "tile", "name": "Feature tile", "settings": [{"type": "text", "id": "title", "label": "Heading", "default": "New arrivals"}, {"type": "image_picker", "id": "image", "label": "Image"}, {"type": "url", "id": "link", "label": "Link"}]}]}{% endschema %}
