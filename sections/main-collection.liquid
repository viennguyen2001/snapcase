<section class="wrap section-space"><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div><form class="sort-form" method="get"><label for="Sort">{{ 'products.sort' | t }}</label><select name="sort_by" id="Sort">{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button type="submit">{{ 'general.update' | t }}</button></form>{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>{{ 'products.empty' | t }}</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>
{% schema %}
{"name": "Main Collection", "settings": [], "presets": [{"name": "Main Collection"}]}
{% endschema %}