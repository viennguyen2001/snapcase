<section class="wrap hero-section">
  <div class="slideshow" aria-roledescription="carousel">
    <div class="slides">
      {% for block in section.blocks %}
        {% liquid
          assign text_color = '#111111'
          assign button_background = '#111111'
          assign button_text = '#ffffff'
          assign copy_justify = 'center'
          assign copy_align = 'center'
          assign copy_text_align = 'center'
          case block.settings.color_scheme
            when 'dark'
              assign text_color = '#ffffff'
              assign button_background = '#ffffff'
              assign button_text = '#111111'
            when 'cream'
              assign text_color = '#31261f'
              assign button_background = '#31261f'
              assign button_text = '#fffaf5'
            when 'custom'
              assign text_color = block.settings.custom_text_color
              assign button_background = block.settings.custom_button_background
              assign button_text = block.settings.custom_button_text
          endcase

          case block.settings.text_position
            when 'top-left'
              assign copy_justify = 'flex-start'
              assign copy_align = 'flex-start'
              assign copy_text_align = 'left'
            when 'center-left'
              assign copy_align = 'flex-start'
              assign copy_text_align = 'left'
            when 'bottom-left'
              assign copy_justify = 'flex-end'
              assign copy_align = 'flex-start'
              assign copy_text_align = 'left'
            when 'top-center'
              assign copy_justify = 'flex-start'
            when 'bottom-center'
              assign copy_justify = 'flex-end'
            when 'top-right'
              assign copy_justify = 'flex-start'
              assign copy_align = 'flex-end'
              assign copy_text_align = 'right'
            when 'center-right'
              assign copy_align = 'flex-end'
              assign copy_text_align = 'right'
            when 'bottom-right'
              assign copy_justify = 'flex-end'
              assign copy_align = 'flex-end'
              assign copy_text_align = 'right'
          endcase
        %}

        <article
          class="slide slide--{{ block.settings.text_position }} slide--mobile-{{ block.settings.mobile_text_position }}"
          id="slide-{{ section.id }}-{{ forloop.index }}"
          style="--hero-text: {{ text_color }}; --hero-button-bg: {{ button_background }}; --hero-button-text: {{ button_text }}; --hero-overlay: {{ block.settings.overlay_color }}; --hero-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}; --hero-copy-justify: {{ copy_justify }}; --hero-copy-align: {{ copy_align }}; --hero-copy-text-align: {{ copy_text_align }};"
          {{ block.shopify_attributes }}
        >
          <picture>
            {% if block.settings.mobile_image != blank %}
              <source
                media="(max-width: 700px)"
                srcset="{{ block.settings.mobile_image | image_url: width: 900 }}"
              >
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 2600
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '900, 1200, 1600, 2200, 2600',
                  sizes: '100vw',
                  alt: block.settings.heading
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'slide__placeholder' }}
            {% endif %}
          </picture>

          {% if block.settings.overlay_opacity > 0 %}
            <span class="slide-overlay" aria-hidden="true"></span>
          {% endif %}

          <div class="hero-copy">
            {% if forloop.first %}
              <h1>{{ block.settings.heading | escape }}</h1>
            {% else %}
              <h2>{{ block.settings.heading | escape }}</h2>
            {% endif %}

            {% if block.settings.link != blank %}
              <a class="button light" href="{{ block.settings.link }}">
                {{ block.settings.button | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="slide-controls">
        {% for block in section.blocks %}
          <button
            type="button"
            data-slide="{{ forloop.index0 }}"
            aria-label="{{ 'general.slide' | t: number: forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

</section>

{% schema %}
{
  "name": "Hero slideshow",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "NOVA Black 3-in-1 Charger"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "default": "center-right",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "center-left", "label": "Center left" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "center", "label": "Center" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "center-right", "label": "Center right" },
            { "value": "bottom-right", "label": "Bottom right" }
          ]
        },
        {
          "type": "select",
          "id": "mobile_text_position",
          "label": "Mobile text position",
          "default": "center",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "center-left", "label": "Center left" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "center", "label": "Center" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "center-right", "label": "Center right" },
            { "value": "bottom-right", "label": "Bottom right" }
          ]
        },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Theme color palette",
          "default": "light",
          "options": [
            { "value": "light", "label": "Light — black text / black button" },
            { "value": "dark", "label": "Dark — white text / white button" },
            { "value": "cream", "label": "Cream — warm brown palette" },
            { "value": "custom", "label": "Custom colors" }
          ]
        },
        {
          "type": "color",
          "id": "custom_text_color",
          "label": "Custom text color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "custom_button_background",
          "label": "Custom button color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "custom_button_text",
          "label": "Custom button text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Image overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "NOVA Black 3-in-1 Charger",
            "button": "SHOP NOW"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "SUMMIT 3-in-1 Wireless Charging Station",
            "button": "SHOP NOW"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "LOC8 URBAN Slim Wallet",
            "button": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
