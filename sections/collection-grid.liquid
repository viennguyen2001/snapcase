<section class="wrap section-space">
  <div class="section-heading">
    <h2>{{ section.settings.heading | escape }}</h2>
    <a href="{{ routes.all_products_collection_url }}">{{ 'general.view_all' | t }} ↗</a>
  </div>

  <div class="category-grid">
    {% for block in section.blocks %}
      {% assign collection_image = block.settings.image | default: block.settings.collection.image %}
      {% if collection_image != blank %}
        <a class="category-tile" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {{ collection_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
          <h3>{{ block.settings.title | escape }} <span>↗</span></h3>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% schema %}
{"name": "Collection Grid", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Our Products"}], "presets": [{"name": "Collection Grid"}], "blocks": [{"type": "collection", "name": "Collection", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Chargers"}, {"type": "collection", "id": "collection", "label": "Collection"}, {"type": "image_picker", "id": "image", "label": "Image"}]}]}
{% endschema %}
