<section class="wrap section-space product-setup-guide">
  <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="product-setup-grid">
    {% for block in section.blocks %}
      <article class="product-setup-step" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}{% endif %}
        <span>{{ forloop.index }}</span>
        <p>{{ block.settings.title | escape }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product setup guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Setup Guide" }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Instruction", "default": "Lightly push tracker puck on hinge side to dislodge" }
  ]}],
  "presets": [{ "name": "Product setup guide", "blocks": [
    { "type": "step", "settings": { "title": "Lightly push tracker puck on hinge side to dislodge" } },
    { "type": "step", "settings": { "title": "Ensure that your tracker is charged" } },
    { "type": "step", "settings": { "title": "Pair puck with Find My app" } },
    { "type": "step", "settings": { "title": "Insert puck with JOURNEY logo facing down." } }
  ] }]
}
{% endschema %}
