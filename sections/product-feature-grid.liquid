<section class="wrap section-space product-feature-grid-section">
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
  <div class="product-feature-grid">
    {% for block in section.blocks %}
      <article class="product-feature-card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.heading }}{% endif %}
        <h3>{{ block.settings.heading | escape }}</h3>
        <div class="rte">{{ block.settings.text }}</div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product feature grid",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Built for every journey" }],
  "blocks": [{ "type": "feature", "name": "Feature", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trackable Everywhere" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Stay connected wherever the day takes you.</p>" }
  ]}],
  "presets": [{ "name": "Product feature grid", "blocks": [
    { "type": "feature", "settings": { "heading": "Trackable Everywhere" } },
    { "type": "feature", "settings": { "heading": "Magnetic Phone Mount" } },
    { "type": "feature", "settings": { "heading": "Keeps Drinks Cold or Hot" } }
  ] }]
}
{% endschema %}
