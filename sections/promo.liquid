<section class="wrap promo">
  {% if section.settings.image != blank or section.settings.mobile_image != blank %}
    <div
      class="promo-banner"
      style="--promo-text: {{ section.settings.text_color }}; --promo-button-bg: {{ section.settings.button_background }}; --promo-button-text: {{ section.settings.button_text }}; --promo-heading-size: {{ section.settings.heading_size | default: 30 }}px; --promo-text-button-gap: {{ section.settings.text_button_gap | default: 10 }}px; --promo-button-width: {{ section.settings.button_width | default: 170 }}px; --promo-button-height: {{ section.settings.button_height | default: 54 }}px; --promo-button-font-size: {{ section.settings.button_font_size | default: 14 }}px;"
    >
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 700px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}"
          >
        {% endif %}

        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              widths: '900, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              alt: section.settings.alt_text
          }}
        {% elsif section.settings.mobile_image != blank %}
          {{
            section.settings.mobile_image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', alt: section.settings.alt_text
          }}
        {% endif %}
      </picture>

      <div class="promo-copy">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.button != blank %}
          <a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
            {{ section.settings.button | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Promo",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "alt_text", "label": "Image alt text", "default": "Promotion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FALL INTO SAVINGS!" },
    { "type": "text", "id": "button", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "link", "label": "Promotion link" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 60, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "text_button_gap", "label": "Text to button spacing", "min": 0, "max": 48, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "button_width", "label": "Button width", "min": 100, "max": 360, "step": 5, "unit": "px", "default": 170 },
    { "type": "range", "id": "button_height", "label": "Button height", "min": 40, "max": 100, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "button_font_size", "label": "Button text size", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button color", "default": "#7d252a" },
    { "type": "color", "id": "button_text", "label": "Button text color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Promo" }]
}
{% endschema %}
