<section class="wrap section-space"><h1>{{ 'cart.title' | t }}</h1>{% if cart.empty? %}<p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy' }}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}<a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><div><label for="Quantity-{{ forloop.index }}">{{ 'products.quantity' | t }}</label><input id="Quantity-{{ forloop.index }}" name="updates[]" type="number" min="0" step="1" value="{{ item.quantity }}"></div></div>{% endfor %}<div class="cart-summary"><label for="CartNote">{{ 'cart.note' | t }}</label><textarea id="CartNote" name="note">{{ cart.note }}</textarea><p>{{ 'cart.total' | t }}: {{ cart.total_price | money }}</p><p class="muted">{{ 'cart.shipping' | t }}</p><button type="submit" name="update">{{ 'general.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></div></form>{% endif %}</section>
{% schema %}
{"name": "Main Cart", "settings": [], "presets": [{"name": "Main Cart"}]}
{% endschema %}