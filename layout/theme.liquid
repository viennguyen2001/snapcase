<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
      {{ page_title | escape }}
      {% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}
    </title>
    <meta name="description" content="{{ page_description | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="website">
    {% if page_image %}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {% endif %}
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'hero-position.css' | asset_url | stylesheet_tag }}
    {{ 'promo.css' | asset_url | stylesheet_tag }}
    {{ 'product.css' | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --global-button-fill: {{ settings.button_fill_color | default: '#7d000c' }};
        --global-button-border: {{ settings.button_border_color | default: '#7d000c' }};
        --global-button-text: {{ settings.button_text_color | default: '#ffffff' }};
        --global-button-hover-text: {{ settings.button_hover_text_color | default: '#7d000c' }};
      }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'slideshow-autoplay.js' | asset_url }}" defer></script>
    <script src="{{ 'product-interactions.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
  </body>
</html>
